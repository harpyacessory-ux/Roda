rules_version = '2';

// Regras do Cloud Firestore da Roda.
// Cole este arquivo inteiro em: console do Firebase > Firestore Database > Regras > Publicar.
// Cada pessoa só lê, grava e apaga o próprio documento (usuarios/{uid}); todo o resto fica fechado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().size() <= 30; // o app usa 16 campos; impede documentos gigantes
    }
  }
}
